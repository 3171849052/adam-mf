#!/usr/bin/env bash
set -euo pipefail
adam_mf_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export PYTHONPATH="$adam_mf_root/src${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1
export ARROW_DEFAULT_MEMORY_POOL=system CUBLAS_WORKSPACE_CONFIG=:4096:8
if command -v python3 >/dev/null 2>&1; then
  exec python3 -B -m adam_mf.bootstrap "$@"
elif [[ -n "${CONDA_PYTHON_EXE:-}" && -x "$CONDA_PYTHON_EXE" ]]; then
  exec "$CONDA_PYTHON_EXE" -B -m adam_mf.bootstrap "$@"
fi
echo '需要 Python 3（系统 Python 或 Conda 基础 Python）来运行管理入口。' >&2
exit 1
